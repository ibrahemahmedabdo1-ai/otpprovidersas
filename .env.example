# OTPProvider environment template. Copy to .env (never commit .env).
# Every value below is a placeholder; none is a working secret.
# Generate secrets with:  openssl rand -base64 48   (ENCRYPTION_KEY: openssl rand -base64 32)

# --- Database (Neon). Use the POOLED string for the API and DIRECT for migrations. ---
DATABASE_URL=
DATABASE_URL_DIRECT=

# --- Core secrets ---
AUTH_SECRET=
SESSION_SECRET=
ENCRYPTION_KEY=            # base64, exactly 32 bytes (AES-256-GCM)
WEBHOOK_SIGNING_SECRET=
API_KEY_PEPPER=            # HMAC pepper for API key hashing
OTP_HASH_PEPPER=           # HMAC pepper for OTP code hashing

# --- First Super Admin bootstrap (one-time, CLI only; remove after use) ---
ADMIN_BOOTSTRAP_SECRET=
ADMIN_BOOTSTRAP_EMAIL=

# --- URLs ---
APP_BASE_URL=https://otpprovider.com
API_BASE_URL=
WORKER_BASE_URL=
CORS_ALLOWED_ORIGINS=

# --- Email (Resend). Domain verification is checked live before activation. ---
RESEND_API_KEY=
EMAIL_FROM=
RESEND_WEBHOOK_SECRET=

# --- OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Private S3-compatible storage ---
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=auto

# --- WhatsApp ---
# Transitional linked-device adapter. Keep false until the compliance checklist
# in docs/security/whatsapp-compliance-checklist.md is signed off.
WHATSAPP_LINKED_DEVICE_ENABLED=false
# Official provider (future). Leave blank until configured.
WHATSAPP_OFFICIAL_PROVIDER=
WHATSAPP_OFFICIAL_API_KEY=

# --- Android signing (GitHub Secrets, not committed) ---
# ANDROID_KEYSTORE_BASE64, ANDROID_KEYSTORE_PASSWORD, ANDROID_KEY_ALIAS, ANDROID_KEY_PASSWORD
# API_BASE_URL_PRODUCTION (repository variable)
